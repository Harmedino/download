# MongoDB connection string (local, docker-compose, or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/snapgrab
PORT=4000
# Exact origin(s) of the Angular client; CORS is restricted to these. Comma-separate several,
# e.g. https://snapgrab.vercel.app,https://snapgrab.com
CLIENT_ORIGIN=http://localhost:4200
# Where downloaded/processed files are written (auto-created)
TEMP_DIR=./tmp
MAX_UPLOAD_MB=50
# Optional overrides if the binaries are not on PATH
YTDLP_PATH=yt-dlp
GALLERYDL_PATH=gallery-dl
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Max size yt-dlp may download per file
MAX_DOWNLOAD_MB=500
# Video background removal limits (CPU-heavy: ~2-3 s per frame on a 4-core machine)
# How long generated files live before cleanup
FILE_TTL_MINUTES=60

# ---- Video tools ----
# Uploads for the video tools (video, audio, image)
MAX_MEDIA_UPLOAD_MB=500
# Longest video/audio the tools accept
MAX_MEDIA_DURATION_MINUTES=60
# Any single processing job is stopped after this long
JOB_TIMEOUT_MINUTES=30
# ffmpeg jobs running at once, and CPU threads each may use. Keep 1 x 2 on small instances.
MEDIA_CONCURRENCY=1
FFMPEG_THREADS=2
# Longest side of any video the tools write (3840 = 4K). Lower it (e.g. 1920) on small instances.
MAX_OUTPUT_SIDE=3840
# Accept public direct links to media files (https://example.com/clip.mp4). SSRF-protected.
DIRECT_URLS_ENABLED=true
