# MongoDB connection string (local, docker-compose, or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/snapgrab
PORT=4000
# Exact origin of the Angular client (CORS is restricted to this)
CLIENT_ORIGIN=http://localhost:4200
# Where downloaded/processed files are written (auto-created)
TEMP_DIR=./tmp
MAX_UPLOAD_MB=50
# Optional overrides if the binaries are not on PATH
YTDLP_PATH=yt-dlp
GALLERYDL_PATH=gallery-dl
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
